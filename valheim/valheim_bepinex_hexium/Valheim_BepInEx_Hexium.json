 others are root-level.\n    if [ -d \"$tmp\/BepInEx\" ]; then\n        package_root=\"$tmp\/BepInEx\"\n    elif [ -d \"$tmp\/${package_name}\/BepInEx\" ]; then\n        package_root=\"$tmp\/${package_name}\/BepInEx\"\n    fi\n\n    # Preserve package layout instead of flattening DLLs. This supports plugins,\n    # patchers, core, monomod, assets, and package-provided config files.\n    mkdir -p \"\/mnt\/server\/BepInEx\/plugins\/${package_name}\"\n\n    if [ -d \"$package_root\/plugins\" ]; then\n        cp -a \"$package_root\/plugins\/.\" \"\/mnt\/server\/BepInEx\/plugins\/${package_name}\/\,
